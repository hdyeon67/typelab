# 프로덕션(빌드타임) env — Cloudflare Workers Builds CI 에서도 참조.
# ⚠️ OG 이미지 URL 이 빌드타임에 인라인되므로 SITE_URL 은 빌드 전 반드시 설정.
# 결제·광고·카카오·계측 키는 여기 두지 않는다(민감값은 .env.local 또는 CF Build 환경변수).
NEXT_PUBLIC_SITE_URL=https://typecut.fineboll.com

# 잠금 상태(회사 표준) — 값이 없으면 각 기능 no-op/미노출.
PAYMENT_ENABLED=false
NEXT_PUBLIC_ADS_ENABLED=false
