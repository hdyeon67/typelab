# 로컬 개발/수동배포용 env 예시. 복사해서 .env.local 로 쓰세요(.env.local 은 gitignore).
# 키가 없으면 해당 기능은 자동 비활성(no-op/미노출)이라, 아무 것도 안 채워도 앱은 동작해요.

NEXT_PUBLIC_SITE_URL=https://typecut.fineboll.com

# ── 광고 (카카오 애드핏) — 도메인 승인 후 실제 노출 ──
NEXT_PUBLIC_ADFIT_UNIT_PC_LEFT=
NEXT_PUBLIC_ADFIT_UNIT_PC_RIGHT=
NEXT_PUBLIC_ADFIT_UNIT_MOBILE=

# ── 광고 (구글 애드센스) ──
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── 카카오 공유 ──
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 계측 (PostHog 쿠키리스) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ── 결제 (사업자등록 전까지 잠금) ──
PAYMENT_ENABLED=false
